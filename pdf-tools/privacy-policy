    }

    p { color: var(--text-secondary); margin-bottom: 16px; font-size: 14px; line-height: 1.8; }

    ul {
      color: var(--text-secondary); font-size: 14px; line-height: 1.8;
      padding-left: 0; margin-bottom: 16px; list-style: none;
      display: flex; flex-direction: column; gap: 8px;
    }
    ul li { display: flex; align-items: flex-start; gap: 10px; }
    ul li::before { content: '–'; color: var(--accent); flex-shrink: 0; margin-top: 1px; }

    a { color: var(--accent2); text-decoration: none; }
    a:hover { text-decoration: underline; }

    strong { color: var(--text-primary); }

    .divider {
      width: 100%; height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
      margin: 44px 0;
    }

    footer {
      border-top: 1px solid var(--border); padding: 36px 40px;
      max-width: 720px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px;
      position: relative; z-index: 1;
