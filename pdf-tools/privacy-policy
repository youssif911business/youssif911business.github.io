  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg0: #060E1A;
      --bg1: #091425;
      --bg2: #0D1F3C;
      --accent: #1A73E8;
      --accent2: #4A9FFF;
      --text-primary: #FFFFFF;
